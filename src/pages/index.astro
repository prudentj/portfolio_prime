---
import Base from '../layouts/Base.astro';
import Swap from '../components/Swap.astro';
import StackStrip from '../components/StackStrip.astro';
import Exhibits from '../components/Exhibits.astro';
import Timeline from '../components/Timeline.astro';
// Scope facts only (Jacob, 22 Oct 2026): no PR or ticket counts on the home page.
const figures = [
  { n: '4 years', t: 'in telehealth commerce, since September 2022' },
  { n: '2', t: 'telehealth platforms led: Invigor Medical and Telegra Commerce' },
  { n: '6 years', t: 'shipping production software, since 2020' },
  { n: '6', t: 'engineers led' },
];
const work = [
  { h: 'One-page checkout', p: 'Specified, reviewed and released with the team. Review caught four release blockers, one of them a security issue. Live since October 2026.' },
  { h: 'Billing correction tool', p: 'A reprice-and-reissue tool for closed billing periods on Stripe Billing. Corrections no longer need a manual reissue.' },
  { h: 'Analytics reconciliation', p: 'Reconciled a client’s conversion funnel against their own data. Our figures matched theirs to within 0.5%.' },
];
const principles = [
  { h: 'Specify before building', p: 'Requirements become tickets the team can build without further questions. 27 product requirement documents became epics this year.' },
  { h: 'Verify', p: 'Reported numbers come from scripts that can be rerun, not from summaries. A suspected cross-client data leak was disproved from delivery records before anyone escalated.' },
  { h: 'Change production carefully', p: 'Back up, dry run, guarded write, verify, keep a revert. Incidents get evidence before a fix.' },
  { h: 'AI-assisted, personally accountable', p: 'Most of my code is written with Claude Code. I decide what is built, review every change and answer for what ships. I also practise without it.' },
];
---
<Base
  title="Jacob Prudent · Engineering Lead, Telehealth Commerce"
  description="Engineering lead at Telegra, responsible for the patient-facing commerce experience: white-labelled storefronts, patient dashboards, checkout and subscriptions.">
  <main class="wrap" data-life>

    <header class="hero">
      <div class="hero-text">
        <h1 class="name-h">Jacob Prudent</h1>
        <p class="role-line"><Swap b="Engineering Lead, Telehealth Commerce" p="Engineering Lead, Telehealth Commerce · flag on" /></p>
        <p class="contact-line">
          <span>Kennewick, WA</span>
          <span class="reloc">Relocating to London or Manchester</span>
          <a href="mailto:jake.prudent@gmail.com">jake.prudent@gmail.com</a>
          <a href="https://www.linkedin.com/in/jacobprudent">LinkedIn</a>
          <a href="https://github.com/prudentj">GitHub</a>
          <a class="cv-link" href="?cv=expanded#cv" data-cv-open>Full CV</a>
        </p>
      </div>
      <!-- Party mode only: the page as a feature flag. Restates the page; no new facts. -->
      <div class="flag-card party-only" aria-label="Feature flag: party mode">
        <div class="fc-top"><span class="fc-key">party_mode</span><span class="fc-type">boolean</span><span class="fc-on">ON</span></div>
        <dl class="fc-rows">
          <div><dt>Serving</dt><dd><code>true</code> to 100% of visitors</dd></div>
          <div><dt>Rollout</dt><dd><span class="fc-bar"><span></span></span> 100%</dd></div>
          <div><dt>Scope</dt><dd><span class="chip">4 yrs telehealth commerce</span><span class="chip">2 platforms led</span><span class="chip">6 engineers</span></dd></div>
          <div><dt>Fallback</dt><dd><code>business</code> · facts unchanged</dd></div>
        </dl>
      </div>
    </header>

    <section aria-labelledby="profile-h" data-file="profile.md">
      <h2 id="profile-h">Profile</h2>
      <p class="profile">Engineering lead with four years in telehealth commerce and six years shipping production software. Lead the Commerce team at Telegra, responsible for the patient-facing experience: white-labelled storefronts, patient dashboards, checkout and subscriptions. Previously Director of Technology at Invigor Medical. Trained as a biochemist, and bring a laboratory’s standard of evidence to software.</p>
      <div class="figures">
        {figures.map((f, i) => <div class="figure reveal" style={`--i:${i}`}><b>{f.n}</b><span>{f.t}</span></div>)}
      </div>
    </section>

    <section aria-labelledby="now-h" data-file="now.md">
      <h2 id="now-h"><Swap b="Current work" p="Currently" /></h2>
      <div class="now-copy">
        <p>I lead the build-out of Telegra Commerce. The platform previously relied on a WooCommerce plugin; it now has its own end-to-end e-commerce solution, tracked from storefront to fulfilment. We are now building the layer above it: a client-facing API, MCP servers and rebuilt patient intake, so partners can launch their own white-labelled telehealth service.</p>
        <p>My role has shifted from writing features to defining them and reviewing what ships. In a regulated space, where mistakes reach patients, clear scoping and a firm quality bar matter more as the team speeds up.</p>
        <p class="stack-line">MERN stack (MongoDB, Express, React, Node) · TypeScript</p>
      </div>
    </section>

    <Timeline />

    <section aria-labelledby="work-h" data-file="selected-work.md">
      <h2 id="work-h">Selected work</h2>
      <ul class="work-list">
        {work.map((w) => <li><b>{w.h}</b><span>{w.p}</span></li>)}
      </ul>
      <p class="more"><a href="/work/commerce">Case study: six months leading a commerce team</a></p>
    </section>

    <section aria-labelledby="how-h" data-file="house-rules.txt">
      <h2 id="how-h"><Swap b="Approach" p="House rules" /></h2>
      <ul class="principles">
        {principles.map((x) => (
          <li class="principle">
            <h3>{x.h}</h3>
            <p>{x.p}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Party mode only: synthetic examples and tool marks. -->
    <section class="party-only" aria-labelledby="ex-h" data-file="exhibits/">
      <div class="section-head">
        <h2 id="ex-h">Show and tell</h2>
        <p>What the work looks like up close. Synthetic examples, no real data.</p>
      </div>
      <StackStrip />
      <Exhibits />
    </section>

    <section class="party-only off-record" aria-labelledby="off-h" data-file="off-the-record.txt">
      <div class="section-head"><h2 id="off-h">Off the record</h2></div>
      <div class="figures party-stats">
        <div class="figure"><b data-glider-count>0</b><span>gliders launched this visit</span></div>
        <div class="figure"><b>n/a</b><span>cups of coffee. Not reported: no script to rerun.</span></div>
        <div class="figure"><b>0</b><span>facts changed by this switch</span></div>
      </div>
      <p class="life-note">The background is Conway’s Game of Life, after a 2020 build-week project. <button type="button" class="glider-btn" data-launch-glider>Launch a glider</button></p>
      <div class="draft">
        <span class="label">Draft · unconfirmed, not live copy</span>
        <p>Outside work: built the website for RadCon, a convention, and writes fiction. [Jacob to confirm both, and whether they belong here.]</p>
      </div>
    </section>

    <section aria-labelledby="story-h" data-file="background.md">
      <h2 id="story-h"><Swap b="Background" p="Origin story" /></h2>
      <div class="draft">
        <span class="label">Draft · Jacob to edit</span>
        <p>I started in laboratories: a biochemistry degree, then assay work at a biotech company and pathogen testing at a food plant. In 2019 I retrained as a developer at Lambda School and stayed on as a section lead.</p>
        <p>I then worked as a contract developer and research assistant at Pathwright, joined Invigor Medical as a full-stack developer and became its Director of Technology. I now lead the Commerce team at Telegra.</p>
        <p>The common thread is a laboratory’s standard of evidence: don’t trust a result you can’t reproduce.</p>
      </div>
    </section>

    <footer id="contact" class="contact">
      <h2 class="label"><Swap b="Contact" p="Say hi" /></h2>
      <p class="contact-line">
        <a href="mailto:jake.prudent@gmail.com">jake.prudent@gmail.com</a>
        <a href="https://www.linkedin.com/in/jacobprudent">LinkedIn</a>
        <a href="https://github.com/prudentj">GitHub</a>
      </p>
    </footer>

  </main>
</Base>
