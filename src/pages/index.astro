---
import Base from '../layouts/Base.astro';
import Swap from '../components/Swap.astro';
import StackStrip from '../components/StackStrip.astro';
import Exhibits from '../components/Exhibits.astro';
import Timeline from '../components/Timeline.astro';
// Scope facts only (Jacob, 22 Oct 2026): no PR or ticket counts on the home page.
const figures = [
  { n: '4 years', t: 'building telehealth commerce, since September 2022' },
  { n: '2', t: 'telehealth platforms led: Invigor Medical and Telegra Commerce' },
  { n: 'SOC 2', t: 'Type II: technical lead for the company’s first audit' },
  { n: '6', t: 'engineers led' },
];
const owns = [
  { k: 'Commerce', v: 'Storefront, one-page checkout and configurable patient journeys for clinic brands.' },
  { k: 'Payments and billing', v: 'Stripe, digital wallets, a new processor integration, subscription renewals and invoicing for clinic tenants.' },
  { k: 'Production', v: 'Deploys, incidents and production data repairs.' },
  { k: 'Security', v: 'Technical lead for the company’s first SOC 2 Type II audit and its penetration test.' },
  { k: 'Team', v: 'Six offshore engineers and QA. I write the specs, plan the sprints, and review and merge the code.' },
];
const principles = [
  { h: 'Specify before building', p: 'Product requirements become tickets the team can build without coming back with questions.', eg: '27 product requirement documents turned into epics this year.' },
  { h: 'Verify everything', p: 'Every number I report comes from a script I can rerun, never from a summary.', eg: 'A suspected cross-client data leak was disproved from delivery records before anyone escalated.' },
  { h: 'Own production', p: 'Back up, dry run, guarded write, verify, keep a revert.', eg: 'A suspected incident gets evidence before it gets a fix: the blast radius is measured, not guessed.' },
  { h: 'AI writes, I answer for it', p: 'I write most of my code with Claude Code. I decide what gets built, review every change and own what ships.', eg: 'I also practise without it, so the underlying skills stay sharp.' },
];
---
<Base
  title="Jacob Prudent · Engineering lead for telehealth commerce"
  description="I lead the Commerce team at Telegra, a telehealth platform: white-labelled storefronts, patient dashboards, checkout and subscriptions.">
  <main class="wrap" data-life>

    <header class="hero">
      <div class="hero-text">
        <div class="name">Jacob Prudent</div>
        <h1><Swap b="Engineering lead for telehealth commerce" p="Telehealth commerce lead, flag on" /></h1>
        <p class="lede">I lead the Commerce team at Telegra, a telehealth platform, where I own <mark>the patient-facing experience</mark>: white-labelled storefronts, patient dashboards, checkout and subscriptions.</p>
        <nav class="links" aria-label="Contact and CV">
          <a class="primary" href="?cv=expanded#cv" data-cv-open>CV</a>
          <a href="#contact">Email</a>
          <a href="https://www.linkedin.com/in/jacobprudent">LinkedIn</a>
          <a href="https://github.com/prudentj">GitHub</a>
        </nav>
      </div>
      <!-- Party mode only: the page as a feature flag. Decorative restatement; no new facts. -->
      <div class="flag-card party-only" aria-label="Feature flag: party mode">
        <div class="fc-top"><span class="fc-key">party_mode</span><span class="fc-type">boolean</span><span class="fc-on">ON</span></div>
        <dl class="fc-rows">
          <div><dt>Serving</dt><dd><code>true</code> to 100% of visitors</dd></div>
          <div><dt>Rollout</dt><dd><span class="fc-bar"><span></span></span> 100%</dd></div>
          <div><dt>Targeting</dt><dd><span class="chip">recruiters</span><span class="chip">hiring managers</span><span class="chip">interviewers</span></dd></div>
          <div><dt>Scope</dt><dd><span class="chip">4 yrs telehealth commerce</span><span class="chip">2 platforms led</span><span class="chip">SOC 2 Type II</span><span class="chip">6 engineers</span></dd></div>
          <div><dt>Fallback</dt><dd><code>business</code> · facts unchanged</dd></div>
        </dl>
        <p class="fc-foot">Flip it back any time: top right.</p>
      </div>
    </header>

    <section aria-labelledby="now-h" data-file="now.md">
      <div class="section-head">
        <h2 id="now-h"><span class="sec" aria-hidden="true">§1</span><Swap b="Now" p="Currently" /></h2>
      </div>
      <div class="now-copy">
        <p>I lead the build-out of Telegra Commerce. Before, the platform relied on a WooCommerce plugin; now it has its own end-to-end e-commerce solution, with tracking from storefront to fulfilment. We’re now building the layer above it: a client-facing API, MCP servers and rebuilt patient intake. Everything our partners need to launch their own white-labelled telehealth service, end to end.</p>
        <p>My work has shifted from writing features to defining them and reviewing what ships. With a team moving at this pace, clear scoping and a firm quality bar matter more than they used to, especially in a regulated space where mistakes reach patients.</p>
        <p class="stack-line">MERN stack (MongoDB, Express, React, Node) · TypeScript</p>
      </div>
      <ul class="owns">
        {owns.map((o) => <li><b>{o.k}</b><span>{o.v}</span></li>)}
      </ul>
      <div class="figures">
        {figures.map((f, i) => <div class="figure reveal" style={`--i:${i}`}><b>{f.n}</b><span>{f.t}</span></div>)}
      </div>
      <p class="more"><a href="/work/commerce"><Swap b="Read the full record →" p="Read the full record (it’s good, promise) →" /></a></p>
    </section>

    <Timeline />

    <section aria-labelledby="how-h" data-file="house-rules.txt">
      <div class="section-head"><h2 id="how-h"><span class="sec" aria-hidden="true">§3</span><Swap b="How I work" p="House rules" /></h2></div>
      <div class="principles">
        {principles.map((x, i) => (
          <div class="principle reveal" style={`--i:${i}`}>
            <h3><span>{i + 1}</span>{x.h}</h3>
            <p>{x.p}</p>
            <p class="eg">{x.eg}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="ex-h" data-file="exhibits/">
      <div class="section-head">
        <h2 id="ex-h"><span class="sec" aria-hidden="true">§4</span><Swap b="Exhibits" p="Show and tell" /></h2>
        <p><Swap b="The paperwork behind the work, and the tools it runs on." p="What the work actually looks like up close, plus the toolbox." /></p>
      </div>
      <StackStrip />
      <Exhibits />
    </section>

    <section class="party-only off-record" aria-labelledby="off-h" data-file="off-the-record.txt">
      <div class="section-head"><h2 id="off-h">Off the record</h2></div>
      <div class="figures party-stats">
        <div class="figure"><b data-glider-count>0</b><span>gliders launched this visit (live count)</span></div>
        <div class="figure"><b>n/a</b><span>cups of coffee. Not reported: there’s no script I can rerun.</span></div>
        <div class="figure"><b>0</b><span>facts that changed when you flipped the flag</span></div>
      </div>
      <p class="life-note">The background is Conway’s Game of Life, a nod to a 2020 build-week project. <button type="button" class="glider-btn" data-launch-glider>Launch a glider</button> <span class="click-hint">or click the top of the page.</span></p>
      <div class="draft">
        <span class="label">Draft · unconfirmed, not live copy</span>
        <p>Outside work: built the website for RadCon, a convention, and writes fiction. [Jacob to confirm both, and whether they belong here.]</p>
      </div>
    </section>

    <section aria-labelledby="story-h" data-file="origin-story.md">
      <div class="section-head"><h2 id="story-h"><span class="sec" aria-hidden="true">§5</span><Swap b="The story so far" p="Origin story" /></h2></div>
      <div class="story">
        <div class="draft">
          <span class="label">Draft · Jacob to edit</span>
          <p>I started in labs: a biochemistry degree, then assay work at a biotech company and pathogen testing at a food plant. In 2019 I retrained as a developer at Lambda School and stayed on as a section lead, mentoring team leads.</p>
          <p>I worked as a contract developer and research assistant at Pathwright, then joined Invigor Medical, a telehealth e-commerce company, as a full-stack developer, and became its Director of Technology. Today I lead the Commerce team at Telegra.</p>
          <p>The thread through all of it is a lab’s standard of evidence: don’t trust a result you can’t reproduce. I hold software to the same standard.</p>
        </div>
      </div>
    </section>


    <footer id="contact" class="contact">
      <span class="label"><Swap b="Contact" p="Say hi" /></span>
      <span class="email">jake.prudent@gmail.com</span>
      <nav class="links" aria-label="Elsewhere">
        <a href="https://www.linkedin.com/in/jacobprudent">LinkedIn</a>
        <a href="https://github.com/prudentj">GitHub</a>
        <a href="?cv=expanded#cv" data-cv-open>Full CV</a>
      </nav>
      <p class="print-only print-links">jacobprudent.com · linkedin.com/in/jacobprudent · github.com/prudentj</p>
      <p class="mode-hint"><Swap b="This page has a party mode, top right. Same facts." p="Back to business? Top right. Same facts." /></p>
    </footer>

  </main>
</Base>
