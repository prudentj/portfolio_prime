---
// Experience: Summary view (role, organisation, dates, one line) and Full CV view (bullets, stack). Internal values: concise / expanded.
// Content lives in src/data/cv.json (shared with the downloadable CV).
import Swap from './Swap.astro';
import cv from '../data/cv.json';
type Role = { title: string; when: string; place?: string; gist: string; bullets?: string[]; stack?: string; link?: string; promoted?: boolean };
type Org = { hash: string; org: string; context: string; place: string; span: string; roles: Role[]; earlier?: boolean };
const orgs = cv.orgs as Org[];
const { skills, education } = cv;
---
<section id="cv" class="cv" data-file="career.log" aria-labelledby="cv-h">
  <div class="cv-head">
    <h2 id="cv-h"><Swap b="Experience" p="Career log" /></h2>
    <div class="cv-tools">
      <button type="button" class="switch cv-switch" data-cv-switch aria-pressed="false" aria-label="Full CV">
        <span class="ms-label ms-b" aria-hidden="true">Summary</span>
        <span class="ms-track" aria-hidden="true"><span class="ms-knob"></span></span>
        <span class="ms-label ms-p" aria-hidden="true">Full CV</span>
      </button>
      <span class="dl">Download CV (<a href="/Jacob-Prudent-CV.pdf" download aria-label="Download CV as PDF">PDF</a> · <a href="/Jacob-Prudent-CV.docx" download aria-label="Download CV as Word">Word</a>)</span>
    </div>
  </div>
  <p class="p-only cv-joke">cv.pdf was moved to the Trash. This page is the CV now.</p>

  <ol class="timeline">
    {orgs.map((o) => (
      <li class:list={['job', { 'job-earlier': o.earlier }]}>
        <div class="job-side">
          <span class="hash" aria-hidden="true">{o.hash}</span>
          <span class="when">{o.span}</span>
        </div>
        <div class="job-main">
          <h3>{o.org}</h3>
          {(o.context || o.place) && <p class="org">{[o.context, o.place].filter(Boolean).join(' · ')}</p>}
          {o.roles.map((r) => (
            <div class:list={['role-block', { 'role-multi': o.roles.length > 1 }]}>
              {!o.earlier && <h4>{r.title}{o.roles.length > 1 && <span class="role-when">{r.when}{r.place && ` · ${r.place}`}</span>}{r.promoted && <span class="label tag-promo">Promoted</span>}</h4>}
              <p class="gist">{r.gist}</p>
              {r.bullets && (
                <div class="cv-more">
                  <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
                  {r.stack && <p class="stack">{r.stack}</p>}
                  {r.link && <p class="more"><a href={r.link}>Read the case study →</a></p>}
                </div>
              )}
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>

  <div class="edu">
    <h3 class="label">Education</h3>
    <ul>
      {education.map((e) => <li><span class="when">{e.when}</span><span>{e.text}</span></li>)}
    </ul>
  </div>

  <div class="edu skills">
    <h3 class="label">Skills</h3>
    <dl>
      {skills.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}
    </dl>
  </div>
</section>
