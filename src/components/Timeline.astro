---
// Career timeline: concise = résumé (role, org, dates, one line); expanded = full CV (bullets, stack, scope).
// Facts: Jacob's own career history (22 Oct 2026) and the verified record on this site. Don't add numbers.
import Swap from './Swap.astro';
type Role = { title: string; when: string; place?: string; gist: string; bullets?: string[]; stack?: string; link?: string; promoted?: boolean };
type Org = { hash: string; org: string; place: string; span: string; roles: Role[]; expandedOnly?: boolean };
const orgs: Org[] = [
  {
    hash: 'a4f1c2e', org: 'Telegra', place: 'Remote / Kennewick, WA', span: '2026 – present',
    roles: [{
      title: 'Commerce Team Lead', when: '2026 – present',
      gist: 'Lead the Commerce team; own the patient-facing experience and the move from a WooCommerce plugin to a native platform.',
      bullets: [
        'Own the patient-facing experience: white-labelled storefronts, patient dashboards, checkout and subscriptions.',
        'Led the migration off a WooCommerce plugin onto native software, including a renewals engine with its own scheduler, worker, failure alerts and recovery sweep.',
        'Led the one-page checkout from specification to release; review caught four release blockers, one of them a security issue.',
        'Built a reprice-and-reissue tool for closed billing periods on Stripe Billing.',
        'Technical lead for the company’s first SOC 2 Type II audit and its penetration test.',
        'Introduced the dev → staging → production release process; run deploys, incidents and production data repairs.',
        'Lead a six-person offshore team and QA: write the specs, plan the sprints, and review and merge the code.',
        'Helped scale the team and establish an AI-assisted development workflow.',
      ],
      stack: 'TypeScript · React · Next.js · Node.js · MongoDB · Redis · BullMQ · Stripe · AWS · Claude Code',
      link: '/work/commerce',
    }],
  },
  {
    hash: '9d27e40', org: 'Invigor Medical', place: '', span: 'Sep 2022 – Apr 2026',
    roles: [
      {
        title: 'Director of Technology', when: 'Jan 2024 – Apr 2026', place: 'Pasco, WA', promoted: true,
        gist: 'Technical owner of a multi-million-dollar telehealth e-commerce platform running high-volume prescription subscriptions.',
        bullets: [
          'Primary technical owner across WooCommerce, Zoho CRM, EHR, e-prescribing and payment systems.',
          'Built and maintained 15+ production automations driving order routing, patient intake, billing triggers and cross-system status sync.',
          'Implemented prescription routing by state, medication type and pharmacy capability.',
          'Designed delayed-capture payment workflows tied to clinician approval.',
          'Built subscription recovery and win-back automation.',
          'Ran dual payment processors (Stripe and Authorize.Net) for resilience.',
          'Led workflow transitions across clinician networks and pharmacy routing with minimal service disruption.',
          'Delivered executive reporting on revenue, cancellations and fulfilment.',
          'Co-led a React and Node.js prescription commerce platform integrating intake, payment and script routing.',
        ],
        stack: 'Zoho (Deluge, Flow) · WooCommerce · WordPress · React · Node.js · Stripe · Authorize.Net · EHR and e-prescribing integrations · Segment · Metorik',
      },
      {
        title: 'Full Stack Developer', when: 'Sep 2022 – Jan 2024', place: 'Kennewick, WA',
        gist: 'Automated operations in Zoho Deluge; built a React/Node patient dashboard.',
      },
    ],
  },
  {
    hash: '5be03a1', org: 'Pathwright', place: 'Remote', span: 'Oct 2020 – Dec 2021',
    roles: [{ title: 'Full Stack Developer (contract)', when: 'Oct 2020 – Dec 2021', gist: 'Developer and research assistant: prototyping, and a hypertext parser and text editor built with React, TypeScript and Slate.js.' }],
  },
  {
    hash: '7c3e9b1', org: 'Lambda School', place: 'Remote', span: '2020',
    roles: [{ title: 'Section Lead', when: '2020', gist: 'Mentored eleven team leads, each supporting 5–12 students.' }],
  },
  {
    hash: '3b8d0f4', org: 'Tyson Foods', place: 'Kennewick area, WA', span: 'Sep 2018 – Sep 2019',
    roles: [{
      title: 'Microbiologist', when: 'Sep 2018 – Sep 2019',
      gist: 'Tested product and environmental samples for food-borne pathogens.',
      bullets: [
        'Tested product and environmental samples for food-borne pathogens (E. coli O157:H7, Listeria).',
        'Recorded results in the laboratory information system and escalated positives to QC and plant management.',
      ],
    }],
  },
  {
    hash: 'e21a6d9', org: 'Santa Cruz Biotechnology', place: 'Sun Valley, ID', span: 'Aug 2017 – Aug 2018',
    roles: [{
      title: 'Research Assistant', when: 'Aug 2017 – Aug 2018',
      gist: 'Antibody screening, western blot development and assay design.',
      bullets: [
        'Micro-array screening of hybridomas for antibody production.',
        'Western blot development.',
        'Assay design and improvement.',
        'Maintained reagent and laboratory inventories.',
      ],
    }],
  },
  {
    hash: '1f0c6b2', org: 'City of Blackfoot', place: 'Blackfoot, ID', span: 'Jun – Nov 2016', expandedOnly: true,
    roles: [{ title: 'Lab Intern', when: 'Jun – Nov 2016', gist: 'EPA-compliance testing: suspended solids, and chemical and biological oxygen demand.' }],
  },
