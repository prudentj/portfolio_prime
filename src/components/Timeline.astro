const education = [
  { when: '2019 – 2020', what: 'Full-stack web development', where: 'Lambda School' },
  { when: '2016', what: 'BSc Biochemistry', where: 'Brigham Young University–Idaho' },
];
---
<section id="cv" class="cv" data-file="career.log" aria-labelledby="cv-h">
  <div class="cv-head">
    <h2 id="cv-h"><span class="sec" aria-hidden="true">§2</span><Swap b="Career" p="Career log" /></h2>
    <div class="cv-tools">
      <button type="button" class="switch cv-switch" data-cv-switch aria-pressed="false" aria-label="Expanded CV">
        <span class="ms-label ms-b" aria-hidden="true">Concise</span>
        <span class="ms-track" aria-hidden="true"><span class="ms-knob"></span></span>
        <span class="ms-label ms-p" aria-hidden="true">Expanded</span>
      </button>
      <button type="button" class="print-btn" data-print>Print / save as PDF</button>
    </div>
  </div>
  <p class="p-only cv-joke">cv.pdf was moved to the Trash. This page is the CV now.</p>

  <ol class="timeline">
    {orgs.map((o) => (
      <li class:list={['job', { 'cv-only': o.expandedOnly }]}>
        <div class="job-side">
          <span class="hash" aria-hidden="true">{o.hash}</span>
          <span class="when">{o.span}</span>
        </div>
        <div class="job-main">
          <h3>{o.org}</h3>
          {o.place && <p class="org">{o.place}</p>}
          {o.roles.map((r) => (
            <div class:list={['role-block', { 'role-multi': o.roles.length > 1 }]}>
              <h4>{r.title}{o.roles.length > 1 && <span class="role-when">{r.when}{r.place && ` · ${r.place}`}</span>}{r.promoted && <span class="label tag-promo">Promoted</span>}</h4>
              <p class="gist">{r.gist}</p>
              {r.bullets && (
                <div class="cv-more">
                  <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
                  {r.stack && <p class="stack">{r.stack}</p>}
                  {r.link && <p class="more"><a href={r.link}>Read the case study →</a></p>}
                </div>
              )}
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>

  <div class="edu">
    <h3 class="label">Education</h3>
    <ul>
      {education.map((e) => <li><span class="when">{e.when}</span><span><b>{e.what}</b>, {e.where}</span></li>)}
    </ul>
  </div>
</section>
