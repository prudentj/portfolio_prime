---
// Business / Party switch. A real <button aria-pressed>, fixed width so nothing moves when it flips.
// State is applied before paint by the inline script in Base.astro and kept in sync by src/scripts/site.js.
---
<button type="button" class="switch mode-switch" data-mode-switch aria-pressed="false" aria-label="Party mode">
  <span class="ms-label ms-b" aria-hidden="true">Business</span>
  <span class="ms-track" aria-hidden="true"><span class="ms-knob"></span></span>
  <span class="ms-label ms-p" aria-hidden="true">Party</span>
</button>
